datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// User role definition
enum Role {
  ADMIN
  FLEET_MANAGER
  DISPATCHER
  SAFETY_OFFICER
  FINANCIAL_ANALYST
}

// Vehicle operating status
enum VehicleStatus {
  AVAILABLE
  ON_TRIP
  IN_SHOP
  RETIRED
}

// Driver status
enum DriverStatus {
  AVAILABLE
  ON_TRIP
  OFF_DUTY
  SUSPENDED
}

// Trip progress status
enum TripStatus {
  DRAFT
  DISPATCHED
  COMPLETED
  CANCELLED
}

// Maintenance status logs
enum MaintenanceStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
}

// Allowed expense categories
enum ExpenseCategory {
  TOLL
  PARKING
  DRIVER_ALLOWANCE
  REPAIR
  MAINTENANCE
  INSURANCE
  PERMIT
  FINE
  MISCELLANEOUS
}

// User model for platform access
model User {
  id              String     @id @default(uuid())
  email           String     @unique
  password        String
  role            Role
  name            String
  phone           String?
  profileImage    String?    // Relative path: uploads/profile-images/<filename>
  department      String?
  designation     String?
  isActive        Boolean    @default(true)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  
  // Relations
  tripsDispatched Trip[]
  auditLogs       AuditLog[]
  driverProfile   Driver?

  @@index([email])
}

// Vehicle assets
model Vehicle {
  id                 String          @id @default(uuid())
  registrationNumber String          @unique
  make               String
  model              String
  year               Int
  capacity           Float           // Cargo payload weight capacity
  odometer           Float           // Odometer reading in KM/Miles
  status             VehicleStatus   @default(AVAILABLE)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  // Relations
  trips              Trip[]
  maintenanceLogs    MaintenanceLog[]
  fuelLogs           FuelLog[]
  expenses           Expense[]

  @@index([registrationNumber])
  @@index([status])
}

// Drivers profile
model Driver {
  id            String       @id @default(uuid())
  name          String
  email         String       @unique
  phone         String
  licenseNumber String       @unique
  licenseExpiry DateTime
  safetyScore   Float        @default(100.0) // Metric 0 - 100
  status        DriverStatus @default(AVAILABLE)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  // Link user profile if driver can access portal
  userId        String?      @unique
  user          User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Relations
  trips         Trip[]
  fuelLogs      FuelLog[]
  expenses      Expense[]

  @@index([email])
  @@index([licenseNumber])
  @@index([status])
}

// Core Operations - Trips
model Trip {
  id             String     @id @default(uuid())
  tripNumber     String     @unique
  vehicleId      String
  vehicle        Vehicle    @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  driverId       String
  driver         Driver     @relation(fields: [driverId], references: [id], onDelete: Restrict)
  dispatcherId   String
  dispatcher     User       @relation(fields: [dispatcherId], references: [id], onDelete: Restrict)
  status         TripStatus @default(DRAFT)
  cargoWeight    Float
  startOdometer  Float
  endOdometer    Float?
  startTime      DateTime?
  endTime        DateTime?
  routeDetails   String?
  revenue        Float?
  fuelUsed       Float?
  cancelReason   String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  // Relations
  expenses       Expense[]

  @@index([tripNumber])
  @@index([status])
  @@index([vehicleId])
  @@index([driverId])
}

// Maintenance operations logs
model MaintenanceLog {
  id          String            @id @default(uuid())
  vehicleId   String
  vehicle     Vehicle           @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  description String
  cost        Float
  status      MaintenanceStatus @default(SCHEDULED)
  startDate   DateTime
  endDate     DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([vehicleId])
  @@index([status])
}

// Refuel Logs
model FuelLog {
  id           String   @id @default(uuid())
  vehicleId    String
  vehicle      Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  driverId     String
  driver       Driver   @relation(fields: [driverId], references: [id], onDelete: Restrict)
  liters       Float
  costPerLiter Float
  totalCost    Float    // Computed as liters * costPerLiter
  odometer     Float    // Current odometer during refuel
  refuelDate   DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([vehicleId])
  @@index([driverId])
}

// Expense Ledger
model Expense {
  id          String          @id @default(uuid())
  vehicleId   String?
  vehicle     Vehicle?        @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  tripId      String?
  trip        Trip?           @relation(fields: [tripId], references: [id], onDelete: Cascade)
  driverId    String?
  driver      Driver?         @relation(fields: [driverId], references: [id], onDelete: SetNull)
  amount      Float
  category    ExpenseCategory
  date        DateTime
  description String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([vehicleId])
  @@index([tripId])
  @@index([category])
}

// Security & Audit Compliance Logs
model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String   // E.g., "USER_LOGIN", "TRIP_DISPATCH"
  entityName String?  // E.g., "Vehicle", "Trip"
  entityId   String?
  details    String?  // JSON string containing payload summary
  ipAddress  String?
  userAgent  String?
  timestamp  DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([timestamp])
}
